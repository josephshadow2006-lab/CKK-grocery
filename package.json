{
  "name": "CKK-grocery",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "cross-env EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 expo start",
    "tunnel": "cross-env EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 expo start --tunnel --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "cross-env EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 expo run:android",
    "ios": "cross-env EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 expo run:ios",
    "web": "cross-env EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 expo start --web",
    "lint": "expo lint",
    "db:push": "drizzle-kit push",
    "seed:grocery": "node ./scripts/seed-grocery.cjs"
  },
  "dependencies": {
    "@clerk/expo": "^3.1.2",
    "@expo/ngrok": "^4.1.0",
    "@expo/vector-icons": "^15.0.2",
    "@neondatabase/serverless": "^1.2.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/elements": "^2.8.1",
    "@react-navigation/native": "^7.0.33",
    "@sentry/react-native": "~7.11.0",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~55.0.0",
    "drizzle-orm": "^0.45.4",
    "expo": "~55.0.0",
    "expo-auth-session": "~55.0.0",
    "expo-constants": "~55.0.0",
    "expo-crypto": "~55.0.0",
    "expo-dev-client": "~55.0.0",
    "expo-device": "~55.0.0",
    "expo-font": "~55.0.0",
    "expo-glass-effect": "~55.0.0",
    "expo-image": "~55.0.0",
    "expo-linear-gradient": "~55.0.0",
    "expo-linking": "~55.0.0",
    "expo-router": "~55.0.0",
    "expo-secure-store": "~55.0.0",
    "expo-splash-screen": "~55.0.0",
    "expo-status-bar": "~55.0.0",
    "expo-symbols": "~55.0.0",
    "expo-system-ui": "~55.0.0",
    "expo-web-browser": "~55.0.0",
    "nativewind": "^4.2.2",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.3.3"
  },
  "private": true
}
